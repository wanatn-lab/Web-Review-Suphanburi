# .env.local.example
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local จะไม่ถูก commit ขึ้น git อยู่แล้ว — เช็คได้ใน .gitignore)

# --- Supabase (ค่าเดิมที่ใช้อยู่แล้ว) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi... (anon/public key — ปลอดภัยเผยแพร่ได้ เพราะมี RLS คุ้มครอง)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- ใหม่: จำเป็นสำหรับระบบดึงคลิปจาก Facebook อัตโนมัติ (app/api/sync-facebook) ---

# Service Role Key: Supabase Dashboard > Project Settings > API > "service_role" (secret)
# ⚠️ คีย์นี้ "ห้ามเผยแพร่" เด็ดขาด (ต่างจาก anon key ข้างบน) เพราะข้ามการป้องกัน RLS ได้ทั้งหมด
# ใช้เฉพาะฝั่งเซิร์ฟเวอร์เท่านั้น (lib/supabase-admin.ts) ไม่มี NEXT_PUBLIC_ นำหน้าโดยตั้งใจ
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Facebook Page ID ของเพจ "รีวิวสุพรรณบุรี" (ตัวเลข ดูวิธีหาใน README ที่แนบมา)
FB_PAGE_ID=100000000000000

# Page Access Token แบบ Long-Lived (อายุ ~60 วัน ต้องรีเฟรชเป็นระยะ — ดูวิธีขอใน README)
FB_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxx

# รหัสลับสำหรับป้องกันไม่ให้คนอื่นยิง /api/sync-facebook มั่ว — ตั้งเป็นสตริงสุ่มยาวๆ เอง
# (Vercel จะแนบ header Authorization: Bearer <ค่านี้> มาให้เองอัตโนมัติตอนที่ Cron Job ยิงจริง)
CRON_SECRET=เปลี่ยนเป็นรหัสสุ่มยาวๆ-ห้ามใช้ค่าตัวอย่างนี้จริง
