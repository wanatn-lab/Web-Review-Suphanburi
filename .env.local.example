# .env.local.example
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local จะไม่ถูก commit ขึ้น git อยู่แล้ว — เช็คได้ใน .gitignore)

# --- Supabase (ค่าเดิมที่ใช้อยู่แล้ว) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi... (anon/public key — ปลอดภัยเผยแพร่ได้ เพราะมี RLS คุ้มครอง)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- ใหม่: จำเป็นสำหรับระบบดึงคลิปจาก Facebook อัตโนมัติ (app/api/sync-facebook) ---

# Service Role Key: Supabase Dashboard > Project Settings > API > "service_role" (secret)
# ⚠️ คีย์นี้ "ห้ามเผยแพร่" เด็ดขาด (ต่างจาก anon key ข้างบน) เพราะข้ามการป้องกัน RLS ได้ทั้งหมด
# ใช้เฉพาะฝั่งเซิร์ฟเวอร์เท่านั้น (lib/supabase-admin.ts) ไม่มี NEXT_PUBLIC_ นำหน้าโดยตั้งใจ
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Facebook Page ID ของเพจ "รีวิวสุพรรณบุรี" (ตัวเลข ดูวิธีหาใน README ที่แนบมา)
FB_PAGE_ID=100000000000000

# Page Access Token แบบ Long-Lived (อายุ ~60 วัน ต้องรีเฟรชเป็นระยะ — ดูวิธีขอใน README)
FB_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxx

# รหัสลับสำหรับป้องกันไม่ให้คนอื่นยิง /api/sync-facebook หรือ
# /api/refresh-facebook-token มั่ว — ตั้งเป็นสตริงสุ่มยาวๆ เอง (ใช้ secret เดียวกัน
# กับทั้ง 2 route) (Vercel จะแนบ header Authorization: Bearer <ค่านี้> มาให้เองอัตโนมัติตอนที่ Cron Job ยิงจริง)
CRON_SECRET=เปลี่ยนเป็นรหัสสุ่มยาวๆ-ห้ามใช้ค่าตัวอย่างนี้จริง

# --- ใหม่: ดึงคลิปล่าสุดจากช่อง YouTube อัตโนมัติ (app/api/sync-youtube) ---
# สร้าง API key แบบจำกัดสิทธิ์ใน Google Cloud แล้วเปิดใช้ YouTube Data API v3
# ค่านี้เป็นความลับ ห้ามใช้ชื่อ NEXT_PUBLIC_ และแนะนำให้จำกัด key ให้เรียก YouTube Data API v3 เท่านั้น
YOUTUBE_API_KEY=
# เว้นว่างได้หากต้องการใช้ช่อง รีวิวสุพรรณบุรีที่ตั้งไว้ในโค้ด
YOUTUBE_CHANNEL_ID=UCa0RGWD2my60NoN2RM04_Xw

# --- ใหม่: ต่ออายุ FB_PAGE_ACCESS_TOKEN อัตโนมัติก่อนหมดอายุทุก ~60 วัน
# (app/api/refresh-facebook-token, ดู lib/facebook-token.ts) ---

# App ID ของแอพ Facebook "Suphan Review Sync" — ดูได้ที่ Facebook Developer
# Dashboard > แอพ > Settings > Basic (ไม่ใช่ความลับ โชว์อยู่บน OAuth consent
# screen อยู่แล้วตอน login)
FB_APP_ID=2054670112107813

# App Secret ของแอพเดียวกัน — Facebook Developer Dashboard > Settings > Basic
# กด "Show" ข้าง App Secret (ต้องยืนยันรหัสผ่าน Facebook อีกครั้งก่อนเห็นค่าจริง)
# ⚠️ ห้ามเผยแพร่เด็ดขาด — ใครมีค่านี้ + FB_APP_ID ออก token ปลอมแอบอ้างแอพนี้ได้
FB_APP_SECRET=

# --- ใหม่: เติมพิกัด lat/lng อัตโนมัติหลังซิงก์จาก Facebook (lib/geocoding.ts) ---

# Google Maps Geocoding API Key
# Enable at: Google Cloud Console > APIs & Services > Geocoding API
# ถ้าไม่ตั้งค่า ระบบยังทำงานได้ตามปกติ แต่จะไม่มีพิกัดอัตโนมัติ
GEOCODING_API_KEY=

# --- ใหม่: ถอดเสียงจากคลิป + เขียนคำโปรย SEO ด้วย AI (lib/audio-transcription.ts,
# lib/seo-content-generator.ts) — ใช้ Cloudflare Workers AI เพราะมีโควตาฟรี
# 10,000 neurons/วัน ซึ่งครอบคลุมปริมาณคลิปของเว็บนี้สบายๆ โดยไม่มีค่าใช้จ่าย ---

# วิธีขอ: Cloudflare Dashboard > บัญชีของคุณ > Workers AI (แถบซ้าย) > ปุ่ม
# "Use REST API" > "Create a Workers AI API Token" (เลือกสิทธิ์ Workers AI -
# Read และ Workers AI - Edit) หน้านั้นจะโชว์ทั้ง Account ID และ API Token ให้คัดลอก
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# ถ้าไม่ตั้งค่า 2 ตัวนี้ ระบบยังบันทึกรีวิวได้ตามปกติทุกอย่าง แค่ไม่มีการถอดเสียง
# และคำโปรย SEO จะกลับไปใช้สูตร keyword เดิม (createManualSeoContent) แทน
